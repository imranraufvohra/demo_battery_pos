# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Existing (Phase 0) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI assistant (Phase 10, Part 1) ---
# Free key: console.groq.com/keys — server-side only, never exposed to the browser.
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-20b (fast, free-tier friendly) if unset.
# See lib/ai/groq.ts for notes and console.groq.com/docs/models for the current list.
# GROQ_MODEL=openai/gpt-oss-20b

# Optional. Which file in lib/ai/personas/ to use (without .md). Defaults to "default".
# AI_ASSISTANT_PERSONA=default

# --- AI assistant rate limit (Phase 10, Part 4) ---
# Optional. Max messages one signed-in user can send within the window below
# before getting a "wait Xs" reply. Defaults: 12 messages / 60 seconds.
# AI_RATE_LIMIT_MAX=12
# AI_RATE_LIMIT_WINDOW_SECONDS=60

# --- Demo deployment (demo.makemystore.online) ---
# NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_AI_ENABLED=true
# NEXT_PUBLIC_FBR_ENABLED=false
# NEXT_PUBLIC_CURRENCY=USD
# NEXT_PUBLIC_LOCALE=en-US
# NEXT_PUBLIC_TIMEZONE=UTC
# NEXT_PUBLIC_PHONE_COUNTRY_CODE=1
# NEXT_PUBLIC_BRAND_NAME=PowerCell Batteries & Solar
# NEXT_PUBLIC_BRAND_SHORT=PowerCell POS
# NEXT_PUBLIC_WEBSITE_URL=https://www.makemystore.online
# DEMO_USER_EMAIL=demo@makemystore.online
# DEMO_USER_PASSWORD=
# DEMO_RESET_SECRET=
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
